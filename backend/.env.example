# Flask
SECRET_KEY=your-32-plus-character-secret-key-here
ADMIN_EMAIL=admin@ppa.com
ADMIN_PASSWORD=admin123

# Database (SQLite default shown; change for PostgreSQL)
DATABASE_URL=sqlite:///placement.db

# Redis
REDIS_URL=redis://localhost:6379/0

# Celery (can be same as REDIS_URL)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Email (Gmail example)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=noreply@hiretrack.com

# AI (optional; used for interview question generation)
AIPIPE_API_KEY=your-aipipe-key

# Export folder for CSV files
EXPORT_FOLDER=./exports
